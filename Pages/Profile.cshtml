@page
@model CodeLensAI.Pages.ProfileModel
@{
    ViewData["Title"] = "User Profile";
}

<div class="container mt-5">
    <h1>@ViewData["Title"]</h1>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title">Account Information</h5>
            <p class="card-text">
                <strong>Name:</strong> @Model.UserProfile.Name
            </p>
            <p class="card-text">
                <strong>Email:</strong> @Model.UserProfile.Email
            </p>
        </div>
    </div>

    <div class="mt-3">
        <p class="text-muted">
            <em>This page displays mock data for preliminary viewing.</em>
        </p>
    </div>
</div>

@section Scripts {
    <!-- Optional: Add any page-specific scripts here if needed -->
}
